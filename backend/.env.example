# Spec-to-Ship Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name

# IBM watsonx Configuration
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx Orchestrate Configuration
ORCHESTRATE_URL=https://your-orchestrate-instance.ibm.com
ORCHESTRATE_INSTANCE_ID=your_orchestrate_instance_id
ORCHESTRATE_AGENT_ID=your_orchestrate_agent_id

# Redis Configuration (Optional - uses in-memory storage if not set)
# Uncomment to enable persistent job storage with Redis
REDIS_URL=redis://localhost:6379

# API Configuration (Optional)
# API_URL=http://localhost:8080
